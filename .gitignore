# Top-level .gitignore for the whole project - consolidated from submodules

# Keep docs at root tracked
/*.md
!/README.md

# Python caches and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo
*.so
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDEs
.idea/
.vscode/

# OS files
.DS_Store
Thumbs.db

# Pip
pip-wheel-metadata/

# Environment files (managed centrally at project root)
.env
.env.example

# Cache and model folders
.cache/
transformers_cache/
#models/
*.cache

**/.claude/
**/.claude-flow/
**/claude.md
.mcp.json

# Logs and test outputs
*.log
test_output/

# SQLite cache
sentiment_agent_cache.sqlite

# Eval cache (regenerated by scripts/evaluation/debate_eval.py)
eval_arrays.npz

# Project-specific
./sentiment_agent_cache.sqlite

md